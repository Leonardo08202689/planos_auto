   <layer-tree-layer legend_split_behavior="0" providerKey="postgres" expanded="1" name="Áreas vulnerables (DENUE)" legend_exp="" source="dbname='gis_empresa' host=100.67.21.105 port=5432 user='qgis_user' key='gid' checkPrimaryKeyUnicity='1' table=&quot;(select gid, geom, nom_estab, nombre_act, codigo_act, round(st_distance(geom,st_transform(st_setsrid(st_makepoint(508832,3207510),32612),6372)))::int dist_m,&#xa; case when codigo_act ~ '^611' then 'Escuelas'&#xa;      when codigo_act ~ '^(621|622|623)' then 'Servicios de salud'&#xa;      when codigo_act ~ '^6244' then 'Guarderías'&#xa;      when codigo_act ~ '^8132' then 'Templos e iglesias'&#xa;      when codigo_act ~ '^(712|7139)' then 'Recreación y cultura'&#xa;      when codigo_act ~ '^931' then 'Oficinas de gobierno' end as categoria&#xa; from inegi.denue where st_dwithin(geom,st_transform(st_setsrid(st_makepoint(508832,3207510),32612),6372),3500) and codigo_act ~ '^(611|621|622|623|6244|8132|712|7139|931)')&quot; (geom)" checked="Qt::Checked" patch_size="-1,-1" id="_reas_vulnerables__DENUE__b7c4562c_1c98_4712_8748_b41c6e966267">
