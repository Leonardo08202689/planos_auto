# ─────────────────────────────────────────────────────────────
#  Credenciales PostgreSQL/PostGIS para generar_planos.py
#  Copia este archivo como .env y llena tus valores reales.
#  NUNCA subas el .env a Git.
# ─────────────────────────────────────────────────────────────

PG_HOST=localhost
PG_PORT=5432
PG_DBNAME=gis_empresa
PG_SCHEMA=proyectos
PG_USER=qgis_user
PG_PASSWORD=tu_password_aqui

# Carpeta base donde se guardan los PNG generados
OUTPUT_BASE=/ruta/a/planos_salida

# Opcional: ruta a un logo alternativo (por defecto usa assets/logo_sinergia.jpg)
LOGO_RUTA=
