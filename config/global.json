{
  "_comentario": "IDs de ítems en las plantillas QPT y ajustes globales de exportación.",
  "ids": {
    "mapa":         "mapa_principal",
    "leyenda":      "leyenda_principal",
    "lbl_proyecto": "lbl_proyecto",
    "lbl_licencia": "lbl_licencia",
    "lbl_plano":    "lbl_tipo_plano",
    "lbl_escala":   "lbl_escala",
    "lbl_fecha":    "lbl_fecha",
    "lbl_fuente":   "lbl_fuente",
    "lbl_coordsys": "lbl_coordsys",
    "lbl_estado":   "lbl_estado",
    "lbl_municipio":"lbl_municipio",
    "logo":         "logo_empresa"
  },
  "dpi": 200,
  "formatos": ["png"],
  "layout_nombre": "Plantilla_Corporativa",
  "coordenadas":   "COORDENADAS UTM WGS84, R12",
  "fecha_plano":   "",

  "estilo_moderno": {
    "_comentario":           "Acabado visual de core/estilo_moderno.py. 'activo': false regresa al estilo de las plantillas. El relieve se calcula del CEM en PostGIS (cem_postgis); CEM_RUTA en el .env usa un archivo local en su lugar.",
    "activo":                true,
    "crs_mapa":              "EPSG:32612",
    "fuente_texto":          "Ubuntu Sans",
    "color_acento":          "#08306b",
    "opacidad_tematica":     0.5,
    "cem_postgis":           "cartografia_base.cem_sonora_15m",
    "relieve_escala_max":    100000,
    "relieve_exageracion":   2.0,
    "relieve_opacidad":      0.38,
    "escala_figura_estatal": 500000
  },

  "mapitas": {
    "_comentario":        "Configura los insertos de localización automáticos.",
    "schema":             "cartografia_base",
    "tabla_estados":      "mexico_estados",
    "tabla_municipios":   "mexico_municipios",
    "campo_nombre":       "nomgeo",
    "campo_cve_ent":      "cve_ent",
    "campo_cvegeo_mun":   "cvegeo",

    "mapitas_layout": {
      "Plantilla_Corporativa": {
        "Mapa 2": { "nivel": "nacional"  },
        "Mapa 3": { "nivel": "estatal"   },
        "Mapa 4": { "nivel": "municipal" }
      },
      "Plantilla_figuras": {
        "Mapa 2": { "nivel": "municipal" }
      },
      "Plantilla_Zonas_Riesgo": {
        "Mapa 2": { "nivel": "nacional" },
        "Mapa 3": { "nivel": "estatal"  }
      },
      "Plantilla_Localizacion_Vulnerabilidad": {
        "Mapa 2": { "nivel": "nacional" },
        "Mapa 3": { "nivel": "estatal"  }
      },
      "Plantilla_Geologia":     { "Mapa 2": { "nivel": "municipal" } },
      "Plantilla_Colindancias": { "Mapa 2": { "nivel": "municipal" } },
      "Plantilla_Vialidades":   { "Mapa 2": { "nivel": "municipal" } }
    }
  },

  "capas_base": {
    "_comentario": "Capas reutilizables en 'capas_postgis' de cualquier proyecto con {\"_ref\": \"<nombre>\"}; las demás claves de la entrada sobreescriben a estas.",
    "areas_vulnerables": {
      "schema": "inegi", "tabla_postgis": "denue", "tipo_geom": "punto",
      "nombre": "Áreas vulnerables",
      "filtro_extra": "codigo_act ~ '^(611|621|622|623|6244|8132|712|7139)'",
      "categorias": {
        "campo": "CASE WHEN \"codigo_act\" LIKE '611%' THEN 'Escuelas' WHEN \"codigo_act\" LIKE '6244%' THEN 'Guarderías' WHEN \"codigo_act\" LIKE '62%' THEN 'Servicios de salud' WHEN \"codigo_act\" LIKE '8132%' THEN 'Templos e iglesias' ELSE 'Recreación y cultura' END",
        "valores": [
          { "valor": "Escuelas",             "forma": "square",     "color": "31,119,255,255" },
          { "valor": "Guarderías",           "forma": "pentagon",   "color": "155,89,182,255" },
          { "valor": "Servicios de salud",   "forma": "cross_fill", "color": "232,35,27,255" },
          { "valor": "Templos e iglesias",   "forma": "star",       "color": "255,191,0,255" },
          { "valor": "Recreación y cultura", "forma": "circle",     "color": "46,204,64,255" }
        ]
      },
      "color_borde": "0,0,0,255", "tamano": "3"
    },
    "colonias": {
      "schema": "inegi", "tabla_postgis": "colonias_nacional", "tipo_geom": "area",
      "nombre": "Colonias y asentamientos",
      "campo_etiqueta": "nom_asen", "umbral_etiqueta": 0,
      "categorias": {
        "campo": "tipo",
        "valores": [
          { "valor": "COLONIA",           "etiqueta": "Colonia",           "color": "255,217,102,90",  "color_borde": "230,168,0,255" },
          { "valor": "FRACCIONAMIENTO",   "etiqueta": "Fraccionamiento",   "color": "244,163,192,90",  "color_borde": "214,51,108,255" },
          { "valor": "PARQUE INDUSTRIAL", "etiqueta": "Parque industrial", "color": "159,197,232,60",  "color_borde": "61,133,198,255" }
        ]
      }
    },
    "vialidades": {
      "schema": "inegi", "tabla_postgis": "vialidades", "tipo_geom": "linea",
      "nombre": "Vialidades",
      "campo_etiqueta": "CASE WHEN \"nomvial\" IN ('Ninguno', 'No Aplica') THEN NULL WHEN \"nomvial\" ILIKE \"tipovial\" || '%' THEN \"nomvial\" ELSE \"tipovial\" || ' ' || \"nomvial\" END",
      "categorias": {
        "campo": "CASE WHEN \"tipovial\" = 'Carretera' THEN 'Carretera' WHEN \"tipovial\" IN ('Boulevard', 'Avenida') THEN 'Vialidad primaria' ELSE 'Vialidad secundaria' END",
        "orden": "CASE WHEN \"tipovial\" = 'Carretera' THEN 3 WHEN \"tipovial\" IN ('Boulevard', 'Avenida') THEN 2 ELSE 1 END",
        "valores": [
          { "valor": "Carretera",           "color": "232,35,27,255",   "color_borde": "90,0,0,255",    "ancho_linea": "1.4" },
          { "valor": "Vialidad primaria",   "color": "255,191,0,255",   "color_borde": "107,79,0,255",  "ancho_linea": "1.0" },
          { "valor": "Vialidad secundaria", "color": "255,255,255,255", "color_borde": "85,85,85,255",  "ancho_linea": "0.5" }
        ]
      }
    }
  }
}
